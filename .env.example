# Copie ce fichier en ".env" et remplis les valeurs (ne JAMAIS committer le .env)

# --- Duffel (app.duffel.com) ---
# Token de TEST commence par "duffel_test_" (bac a sable, prix fictifs)
# Token LIVE  commence par "duffel_live_" (vrais prix)
DUFFEL_ACCESS_TOKEN=duffel_test_votre_token_ici
# --- Telegram ---
TELEGRAM_BOT_TOKEN=votre_bot_token_ici
TELEGRAM_CHAT_ID=votre_chat_id_ici
